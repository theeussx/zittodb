{
  "name": "zittodb",
  "private": true,
  "version": "0.1.0",
  "description": "Zittodb — Android Debug Bridge, direto e local. Toolkit gráfico e leve para ADB, scrcpy e fastboot no Linux.",
  "keywords": [
    "adb",
    "android",
    "scrcpy",
    "fastboot",
    "linux",
    "tauri",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theeussx/zittodb.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "check:deps": "bash scripts/check-deps.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev:demo": "vite --mode demo",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
