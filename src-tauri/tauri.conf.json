{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zittodb",
  "version": "0.1.3",
  "identifier": "app.zittodb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zittodb",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Android Debug Bridge, direto e local",
    "longDescription": "Zittodb é uma ferramenta gráfica, leve e local-first para trabalhar com Android Debug Bridge, scrcpy e fastboot no Linux: gerenciamento de dispositivos, shell, screenshots, espelhamento de tela, gestão de aplicativos com debloat, transferência de arquivos, logcat, diagnóstico, auditoria e histórico. Sem nuvem, sem contas e sem telemetria.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/theeussx/zittodb/releases/latest/download/latest.json"
      ]
    }
  }
}
